# Copy to .env and adjust before running: docker compose up --build

# Backend
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:8080
BACKEND_PORT=5000

# Frontend
FRONTEND_PORT=8080

# Database (leave empty to use embedded PGlite with persistent volume)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/shelfmark

# Postgres profile only (docker compose --profile postgres up --build)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=shelfmark
# POSTGRES_PORT=5432
